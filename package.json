{
  "name": "lontara",
  "version": "0.0.0",
  "private": true,
  "description": "Lontara reading and writing explainer for Bugis (Basa Ugi). Enumerates what the script leaves undetermined.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm rules:validate && pnpm lexicon:validate && next build",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:enumerate": "vitest run tests/enumerate",
    "rules:validate": "tsx scripts/rules-validate.ts",
    "rules:report": "tsx scripts/rules-report.ts",
    "lexicon:validate": "tsx scripts/lexicon-validate.ts",
    "gate:check": "tsx scripts/gate-check.ts",
    "fonts:subset": "node scripts/fonts-subset.mjs",
    "render:conformance": "tsx scripts/render-conformance.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
