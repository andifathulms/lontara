{
  "$comment": [
    "Every URL here is RELATIVE, resolved against the manifest's own location — the",
    "same trick public/index.html uses. It therefore works unchanged at / under",
    "`pnpm dev` and at /lontara/ on Pages, with no build-time substitution and",
    "nothing to keep in sync with next.config.js.",
    "",
    "start_url is id/ rather than ./ because the bare root is only a redirect stub;",
    "launching an installed app into a meta-refresh would show a blank frame first.",
    "",
    "background_color is the app's own ground (#1A1614, PRD §10), not the icon",
    "tile's #15120C — the splash is the app arriving, so it should match what",
    "arrives. See public/icon/BRAND.md on why those two differ at all."
  ],
  "name": "Lontara — penjelas baca-tulis aksara Lontara",
  "short_name": "Lontara",
  "description": "Penjelas baca-tulis aksara Lontara untuk Basa Ugi. Menyebut satu per satu apa yang tidak ditentukan oleh aksara.",
  "lang": "id",
  "dir": "ltr",
  "start_url": "id/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1A1614",
  "theme_color": "#1A1614",
  "categories": ["education", "reference", "utilities"],
  "icons": [
    {
      "src": "icon/lontara-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon/lontara-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon/lontara-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
